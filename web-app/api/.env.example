# Local development environment template for web-app/api (Standard architecture).
# Copy to `.env` for local runs — NEVER commit `.env` or real secrets.

# Runtime PostgreSQL connection using the least-privilege `app_user` role (NOBYPASSRLS).
# Matches root `compose.yaml` (`docker compose --profile standard up -d postgres`).
DATABASE_URL=postgres://app_user:local-dev-app-password@127.0.0.1:5432/app

# Dedicated schema-owner connection used ONLY with `--migrate-only` (never for runtime serving):
# DATABASE_URL=postgres://migrator:local-dev-migrator-password@127.0.0.1:5432/app

# Shared HMAC-SHA256 secret for verifying short-lived `x-app-user-token` JWTs minted by web-app/app.
# Must be at least 32 bytes in release/production builds.
INTERNAL_API_JWT_SECRET=CHANGE_ME_LOCAL_DEV_INTERNAL_API_JWT_SECRET_32_BYTES_MIN

# HTTP bind port (Cloud Run injects PORT=8080).
PORT=8080

# Structured JSON log filter (e.g., info, debug, lean_cloud_app_api=debug,sqlx=warn).
RUST_LOG=info
